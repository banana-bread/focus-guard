{
  "name": "focus-guard",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "node --experimental-strip-types ./node_modules/eslint/bin/eslint.js src/",
    "lint:fix": "node --experimental-strip-types ./node_modules/eslint/bin/eslint.js src/ --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "bash -c 'tsc --noEmit -p tsconfig.json'"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "latest",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.0.0",
    "jiti": "^2.6.1",
    "jsdom": "latest",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "simple-git-hooks": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^1.0.0",
    "vitest": "^2.0.0"
  }
}
